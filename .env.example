# Edu360 shared environment
# Copy to .env for local tooling. App-specific variables live in:
# - edu360_web/.env
# - edu_mobile/.env

# -----------------------------------------------------------------------------
# Supabase project
# -----------------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional. Useful for direct SQL tooling/migrations outside Supabase CLI.
SUPABASE_DB_URL=

# -----------------------------------------------------------------------------
# App URLs
# -----------------------------------------------------------------------------
WEB_APP_URL=http://localhost:3000
MOBILE_DEEP_LINK_SCHEME=edu360

# -----------------------------------------------------------------------------
# Notifications
# -----------------------------------------------------------------------------
# FCM remains the complementary push channel defined by the backlog.
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=

# -----------------------------------------------------------------------------
# Email / transactional delivery
# Supabase Auth templates are configured in the Supabase dashboard, but these are
# useful if Edge Functions or server routes send product emails later.
# -----------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
