#
# Edu360 Web environment
#

# -----------------------------------------------------------------------------
# Supabase - target backend
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Never expose with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=

# Public URL used by auth callbacks and links.
NEXT_PUBLIC_WEB_APP_URL=http://localhost:3000
NEXT_PUBLIC_MOBILE_DEEP_LINK_SCHEME=edu360

# -----------------------------------------------------------------------------
# Firebase legacy - required while existing code is being migrated
# -----------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
# Ejemplo: gs://tu-proyecto.firebasestorage.app (también acepta sin gs://)
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Server-side Firebase Admin legacy. Prefer FIREBASE_SERVICE_ACCOUNT_JSON for
# local development, or GOOGLE_APPLICATION_CREDENTIALS_JSON if already available.
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_SERVICE_ACCOUNT_KEY=
GOOGLE_APPLICATION_CREDENTIALS_JSON=

# Institution scoping (optional)
# Used to scope Firestore paths like institutions/{INSTITUTION_ID}/...
# Falls back to "default" if not set.
INSTITUTION_ID=
NEXT_PUBLIC_INSTITUTION_ID=

# -----------------------------------------------------------------------------
# Notifications / email
# -----------------------------------------------------------------------------
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
